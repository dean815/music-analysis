# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# ---------- Project artifacts (regenerable) ----------
out/
previews/

# The bundled example is tracked input data, but real_book.py --out examples/demo
# writes its rendered chart back into that directory. Regenerable output, and the
# README tells people to run exactly that command.
examples/*/real_book.txt

# Audio + MIDI files anywhere in the tree.
# Scripts produce these from inputs you point at via env vars; they don't
# belong in version control. Remove these lines if you decide to track demos.
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.mid
*.midi

# ---------- Local config / secrets ----------
# The .env file holds your personal MUSIC_AUDIO/MUSIC_XML paths.
# .env.example IS tracked (template) but .env itself is private.
.env
.env.local

# Claude Code per-machine settings (permission allowlists, etc.)
.claude/settings.local.json

# Per-session git worktrees. Concurrent sessions each get their own checkout here
# so they don't stage over each other — see CLAUDE.md. Machine-local state, and
# each one contains a .git file that would otherwise show up as an untracked repo.
.claude/worktrees/

# Session-handoff scratch state (personal workflow notes, not project content)
.remember/

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS junk ----------
.DS_Store
Thumbs.db
