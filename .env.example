# Copy this file to `.env` and fill in your own paths.
# `.env` is gitignored; `.env.example` is committed as a template.
#
# Load with:  set -a; source .env; set +a
# Or use a tool like direnv / dotenv that auto-loads when you `cd` into the project.

# Path to your audio bounce (WAV recommended; FLAC/AIFF also fine)
MUSIC_AUDIO=/path/to/your/bounce.wav

# Path to the MusicXML export of your harmonic parts (keyboard, bass)
MUSIC_XML=/path/to/your/score.xml

# Optional: separate MusicXML for guitar/lead parts (used by xml_guitars.py)
MUSIC_GUITARS_XML=/path/to/your/score-guitars.xml

# Optional: override default output directories (default ./out and ./previews under project root)
# MUSIC_OUT=./out
# MUSIC_PREVIEWS=./previews
